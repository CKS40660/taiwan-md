---
/**
 * /brand — Taiwan.md 識別手冊 v2（2026-10-22）。
 *
 * 這一頁不手寫任何幾何與色值：標誌、地形行、標準字外框、色彩 tokens 全部來自
 * src/data/brand/identity.json（由 docs/brand/source/build-identity.mjs 產生），
 * 圖示來自 src/icons/taiwan-icons.mjs。規範改了，改上游再重建，這頁跟著變。
 * 設計報告：reports/design-identity-system-2026-10-22.md
 */
import Layout from '../layouts/Layout.astro';
import identity from '../data/brand/identity.json';
import { emojiIcons, icons, iconGroups } from '../icons/taiwan-icons.mjs';
const emojiCount = Object.keys(emojiIcons).length;

type Rect = { x: number; y: number; w: number; h: number; t: number };
const I = identity as any;
const LT = I.tokens.modes.light.tokens as Record<string, string>;
const DT = I.tokens.modes.dark.tokens as Record<string, string>;
const islandW: number = I.island.width;
const islandH: number = I.island.height;

// ── 色彩換算：WCAG 對比與 OKLCH（只為了把數字印在色票上）────────────
const hexRgb = (h: string) => {
  const n = parseInt(h.slice(1), 16);
  return [(n >> 16) & 255, (n >> 8) & 255, n & 255];
};
const lin = (c: number) => {
  c /= 255;
  return c <= 0.04045 ? c / 12.92 : ((c + 0.055) / 1.055) ** 2.4;
};
const lum = (h: string) => {
  const [r, g, b] = hexRgb(h).map(lin);
  return 0.2126 * r + 0.7152 * g + 0.0722 * b;
};
const contrast = (a: string, b: string) => {
  const [x, y] = [lum(a), lum(b)].sort((p, q) => q - p);
  return (x + 0.05) / (y + 0.05);
};
const oklch = (h: string) => {
  const [r, g, b] = hexRgb(h).map(lin);
  const l = Math.cbrt(0.4122214708 * r + 0.5363325363 * g + 0.0514459929 * b);
  const m = Math.cbrt(0.2119034982 * r + 0.6806995451 * g + 0.1073969566 * b);
  const s = Math.cbrt(0.0883024619 * r + 0.2817188376 * g + 0.6299787005 * b);
  const L = 0.2104542553 * l + 0.793617785 * m - 0.0040720468 * s;
  const A = 1.9779984951 * l - 2.428592205 * m + 0.4505937099 * s;
  const B = 0.0259040371 * l + 0.7827717662 * m - 0.808675766 * s;
  const C = Math.hypot(A, B);
  const H = ((Math.atan2(B, A) * 180) / Math.PI + 360) % 360;
  return `oklch(${L.toFixed(3)} ${C.toFixed(3)} ${H.toFixed(0)})`;
};

// ── SVG 小工具 ────────────────────────────────────────────────────────
const f = (n: number) => +n.toFixed(2);
const markSvg = (
  rects: Rect[],
  {
    ink = 'var(--b-ink-1)',
    acc = 'var(--b-brand)',
    pad = 0.12,
    title = 'Taiwan.md 標誌：行島',
  } = {},
) => {
  const p = islandW * pad;
  return `<svg viewBox="${-p} ${-p} ${f(islandW + 2 * p)} ${f(islandH + 2 * p)}" width="${f((islandW + 2 * p) / 10)}" height="${f((islandH + 2 * p) / 10)}" role="img" aria-label="${title}">${rects
    .map(
      (r) =>
        `<rect x="${r.x}" y="${r.y}" width="${r.w}" height="${r.h}" fill="${r.t ? acc : ink}"/>`,
    )
    .join('')}</svg>`;
};
const pixelSvg = (rects: Rect[], size: number) =>
  `<svg viewBox="0 0 ${size} ${size}" shape-rendering="crispEdges" role="img" aria-label="${size} 像素版">${rects
    .map(
      (r) =>
        `<rect x="${r.x}" y="${r.y}" width="${r.w}" height="${r.h}" fill="${r.t ? 'var(--b-brand)' : 'var(--b-ink-1)'}"/>`,
    )
    .join('')}</svg>`;
const LK = I.lockup;
const lockupSvg = ({
  zh = false,
  ink = 'var(--b-ink-1)',
  acc = 'var(--b-brand)',
  sub = 'var(--b-ink-2)',
  guides = false,
} = {}) => {
  const c = LK.clear;
  const top = Math.min(LK.markTop, -LK.capHeight) - c;
  const bottom =
    Math.max(
      LK.markTop + LK.markHeight,
      zh ? LK.zhBaseline + LK.capHeight * 0.12 : 0,
    ) + c;
  const width = LK.textX + Math.max(LK.wordWidth, zh ? LK.zhWidth : 0) + c * 2;
  const s = LK.markHeight / islandH;
  const mark = (I.master as Rect[])
    .map(
      (r) =>
        `<rect x="${f(r.x * s)}" y="${f(LK.markTop + r.y * s)}" width="${f(r.w * s)}" height="${f(r.h * s)}" fill="${r.t ? acc : ink}"/>`,
    )
    .join('');
  // 標準字外框只在頁首的 sprite 寫一次，這裡用 <use> 引用，顏色經 CSS 變數傳進去
  const words = `<use href="#b-word" style="--wi:${ink};--wa:${acc}"/>`;
  const zhp = zh ? `<use href="#b-zh" style="--ws:${sub}"/>` : '';
  const g = guides
    ? `<g fill="none" stroke="var(--b-signal)" stroke-width="14" stroke-dasharray="40 26" opacity=".9">
        <rect x="${f(-c)}" y="${f(top)}" width="${f(width)}" height="${f(bottom - top)}"/>
        <line x1="${f(-c)}" x2="${f(width - c)}" y1="0" y2="0"/>
        <line x1="${f(-c)}" x2="${f(width - c)}" y1="${f(-LK.capHeight)}" y2="${f(-LK.capHeight)}"/>
        <line x1="${LK.markWidth}" x2="${LK.markWidth}" y1="${f(top)}" y2="${f(bottom)}"/>
        <line x1="${LK.textX}" x2="${LK.textX}" y1="${f(top)}" y2="${f(bottom)}"/>
      </g>`
    : '';
  return `<svg viewBox="${f(-c)} ${f(top)} ${f(width)} ${f(bottom - top)}" width="${f(width / 10)}" height="${f((bottom - top) / 10)}" role="img" aria-label="Taiwan.md 標誌與標準字組合">${mark}<g transform="translate(${LK.textX} 0)">${words}${zhp}</g>${g}</svg>`;
};
const ridgeSvg = ({
  stroke = 'var(--b-ink-1)',
  bg = 'var(--b-paper)',
  sw = 4.2,
} = {}) => {
  const pad = islandW * 0.08;
  const lift = islandH * 0.1;
  return `<svg viewBox="${-pad} ${f(-pad - lift)} ${f(islandW + 2 * pad)} ${f(islandH + 2 * pad + lift)}" role="img" aria-label="地形行：台灣本島 26 行依真實高程抬升"><use href="#b-ridge" style="--rs:${stroke};--rb:${bg};--rw:${sw}"/></svg>`;
};
// 地形行與標準字外框各寫一次，頁面其他地方用 <use> 引用（同一份路徑出現十幾次，省下約 400 KB）
const sprite = `<svg width="0" height="0" style="position:absolute" aria-hidden="true"><defs>
<symbol id="b-ridge" overflow="visible">${(I.ridge as any[])
  .map((r) => {
    const last = r.d.match(/([\d.]+) [\d.]+$/)[1];
    const first = r.d.match(/^M([\d.]+)/)[1];
    return `<path d="${r.d}L${last} ${r.base}L${first} ${r.base}Z" style="fill:var(--rb)"/><path d="${r.d}" fill="none" style="stroke:${r.t ? 'var(--b-brand)' : 'var(--rs)'};stroke-width:var(--rw)" stroke-linejoin="round"/>`;
  })
  .join('')}</symbol>
<symbol id="b-word" overflow="visible">${(I.wordmark.paths as any[])
  .map(
    (p) =>
      `<path d="${p.d}" style="fill:var(${p.role === 'md' ? '--wa' : '--wi'})"/>`,
  )
  .join('')}</symbol>
<symbol id="b-zh" overflow="visible">${(I.wordmark.zh.paths as string[])
  .map((d) => `<path d="${d}" style="fill:var(--ws)"/>`)
  .join('')}</symbol>
</defs></svg>`;
const iconSvgInline = (name: string, size = 24, extra = '') =>
  `<svg viewBox="0 0 24 24" width="${size}" height="${size}" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="butt" stroke-linejoin="miter" aria-hidden="true" ${extra}><path d="${(icons as Record<string, string>)[name]}"/></svg>`;

// ── 章節 ──────────────────────────────────────────────────────────────
const chapters = [
  ['concept', '一句話'],
  ['use', '誰可以怎麼用'],
  ['mark', '標誌'],
  ['misuse', '不要這樣用'],
  ['color', '色彩'],
  ['type', '字體'],
  ['icons', '圖示'],
  ['layers', '四層圖形'],
  ['layout', '版型與聲音'],
  ['apps', '應用範例'],
  ['downloads', '下載'],
  ['log', '版本紀錄'],
];

// ── 色彩角色表 ────────────────────────────────────────────────────────
const roles = [
  {
    key: 'paper',
    name: '紙',
    use: '版面底色，佔畫面七成以上',
    never: '米黃紙色、漸層底',
  },
  {
    key: 'paper-2',
    name: '紙・次',
    use: '卡片、區塊交替、程式碼底',
    never: '跟 paper 相鄰時再加框線',
  },
  {
    key: 'ink-1',
    name: '墨（黑潮）',
    use: '標題、內文、標誌的行',
    never: '純黑 #000 鋪大面積',
  },
  {
    key: 'ink-2',
    name: '墨・次',
    use: '次要文字、說明、中文副標',
    never: '小於 13 px 的正文',
  },
  {
    key: 'ink-3',
    name: '墨・提示',
    use: '提示、圖說、時間戳',
    never: '可點擊的文字',
  },
  {
    key: 'brand',
    name: '臺灣青',
    use: '北迴歸線那一行、.md、連結、焦點框',
    never: '大面積底色、漸層、超過版面 10%',
  },
  {
    key: 'signal',
    name: '九重葛',
    use: '一頁一處：勘誤、最重要的那個數字',
    never: '錯誤狀態（用 bad）、裝飾',
  },
  {
    key: 'ok',
    name: '狀態・好',
    use: '通過、上線、已驗證（一定配圖示與文字）',
    never: '當第四個類別色',
  },
  {
    key: 'warn',
    name: '狀態・注意',
    use: '待確認、過期、低信心',
    never: '標題強調',
  },
  {
    key: 'bad',
    name: '狀態・嚴重',
    use: '失敗、錯誤、斷鏈',
    never: '品牌強調',
  },
];
const pairs = [
  ['ink-1', 'paper'],
  ['ink-2', 'paper'],
  ['ink-3', 'paper'],
  ['ink-1', 'paper-2'],
  ['ink-3', 'paper-2'],
  ['brand', 'paper'],
  ['brand', 'paper-2'],
  ['on-brand', 'brand'],
  ['signal', 'paper'],
  ['brand-strong', 'brand-soft'],
].map(([fg, bg]) => ({
  fg,
  bg,
  light: contrast(LT[fg], LT[bg]),
  dark: contrast(DT[fg], DT[bg]),
}));
const catNames: string[] = I.tokens.categorical_names;
const catLight: string[] = I.tokens.categorical.light;
const catDark: string[] = I.tokens.categorical.dark;
const seqLight: string[] = I.tokens.sequential.light;
const seqDark: string[] = I.tokens.sequential.dark;

// ── 圖示分組 ──────────────────────────────────────────────────────────
const groupMeta: Record<string, { title: string; note: string }> = {
  category: {
    title: '分類',
    note: '十四個分類各一支，不再兩兩共用。文化用燕尾脊廟頂、生活用機車、政治用選票箱。',
  },
  interface: {
    title: '介面',
    note: '導覽、按鈕、狀態。尺寸以 16 與 20 為主。',
  },
  content: {
    title: '內容',
    note: '文章與資料裡的物件。有面積的地方一律畫行線，不填滿。',
  },
};
const groups = Object.entries(
  iconGroups as Record<string, Record<string, string>>,
);
const iconCount = Object.keys(icons).length;

// ── 基因條示範（D 層）：真實文章的封面圖 ───────────────────────────────
const genes = [
  {
    title: '黃魚鴞',
    href: '/nature/黃魚鴞',
    img: '/article-images/nature/tawny-fish-owl-gailhampshire-2009.webp',
  },
  {
    title: '大安溪倚天劍',
    href: '/nature/大安溪倚天劍',
    img: '/article-images/nature/taiwania-nantou-shihchuan.webp',
  },
  {
    title: '颱風',
    href: '/nature/颱風',
    img: '/article-images/nature/morakot-modis-satellite-2009.webp',
  },
  {
    title: '夜市文化',
    href: '/food/夜市文化',
    img: '/article-images/food/shilin-night-market-crowd-2015.webp',
  },
  {
    title: '台灣醬油',
    href: '/food/醬油',
    img: '/article-images/food/wanjashan-soy-sauce-2006.webp',
  },
  {
    title: '台灣早餐文化',
    href: '/food/台灣早餐文化',
    img: '/article-images/food/taiwan-breakfast-hero-set.webp',
  },
];

const downloads: string[] = I.downloads;
const dlNote: Record<string, string> = {
  'taiwanmd-lockup.svg': '組合・淺底（預設交付）',
  'taiwanmd-lockup-dark.svg': '組合・深底（自帶底色）',
  'taiwanmd-lockup-zh.svg': '組合＋中文副標・淺底',
  'taiwanmd-lockup-zh-dark.svg': '組合＋中文副標・深底',
  'taiwanmd-mark.svg': '標誌・淺底',
  'taiwanmd-mark-dark.svg': '標誌・深底',
  'taiwanmd-mark-mono.svg': '標誌・單色（currentColor）',
  'taiwanmd-wordmark.svg': '標準字（無標誌）',
  'taiwanmd-favicon-16.svg': '16 px 逐像素版',
  'taiwanmd-favicon-32.svg': '32 px 逐像素版',
  'taiwanmd-app-icon.svg': 'App 圖示（墨色方塊）',
  'taiwanmd-app-icon-180.png': 'App 圖示 180（apple-touch）',
  'taiwanmd-app-icon-192.png': 'App 圖示 192',
  'taiwanmd-app-icon-512.png': 'App 圖示 512',
  'taiwanmd-lockup-256.png': '組合・淺底點陣（高 256）',
  'taiwanmd-lockup-dark-256.png': '組合・深底點陣（高 256）',
  'taiwanmd-ridge.svg': '地形行・淺底',
  'taiwanmd-ridge-dark.svg': '地形行・深底',
  'taiwanmd-tokens.json': '色彩 tokens（兩模式）',
};
const peakLat = 23.47;
const geneReadingSvg = markSvg(
  (I.master as (Rect & { p: number })[]).map((r) => {
    const k = 0.35 + 0.95 * (r.p / 3952);
    return { ...r, y: f(r.y + r.h / 2 - (r.h * k) / 2), h: f(r.h * k) };
  }),
  { title: '基因讀法：每一行的粗細依它經過的最高點' },
);
const centeredSvg = markSvg(
  (I.master as Rect[]).map((r) => ({ ...r, x: islandW / 2 - r.w / 2 })),
);
const geoSvg = (() => {
  const p = islandW * 0.12;
  const rows = I.master as Rect[];
  const tr = rows.find((r) => r.t)!;
  const cy = tr.y + tr.h / 2;
  return `<svg viewBox="${-p} ${-p} ${f(islandW + 2 * p + 520)} ${f(islandH + 2 * p)}" role="img" aria-label="標誌幾何圖">
                ${rows.map((r) => `<line x1="${-p}" x2="${islandW + p}" y1="${f(r.y + r.h / 2)}" y2="${f(r.y + r.h / 2)}" stroke="var(--b-line)" stroke-width="2"/>`).join('')}
                ${rows.map((r) => `<rect x="${r.x}" y="${r.y}" width="${r.w}" height="${r.h}" fill="${r.t ? 'var(--b-brand)' : 'var(--b-ink-1)'}"/>`).join('')}
                <line x1="${-p}" x2="${islandW + p + 40}" y1="${f(cy)}" y2="${f(cy)}" stroke="var(--b-brand)" stroke-width="3" stroke-dasharray="14 10"/>
                <text x="${islandW + p + 60}" y="${f(cy + 14)}" font-size="56" fill="var(--b-brand)" font-family="IBM Plex Mono, monospace">23.4365°N</text>
                <text x="${islandW + p + 60}" y="${f(cy + 66)}" font-size="46" fill="var(--b-ink-3)" font-family="IBM Plex Mono, monospace">北迴歸線</text>
                <text x="${islandW + p + 60}" y="${f(rows[0].y + 30)}" font-size="46" fill="var(--b-ink-3)" font-family="IBM Plex Mono, monospace">${I.island.bounds.north.toFixed(2)}°N</text>
                <text x="${islandW + p + 60}" y="${f(islandH)}" font-size="46" fill="var(--b-ink-3)" font-family="IBM Plex Mono, monospace">${I.island.bounds.south.toFixed(2)}°N</text>
                <text x="${islandW + p + 60}" y="${f(islandH * 0.2)}" font-size="46" fill="var(--b-ink-3)" font-family="IBM Plex Mono, monospace">行距 ${f(islandH / I.spec.lines)} 列</text>
                <text x="${islandW + p + 60}" y="${f(islandH * 0.2 + 48)}" font-size="46" fill="var(--b-ink-3)" font-family="IBM Plex Mono, monospace">行粗 × ${I.spec.weight}</text>
              </svg>`;
})();
const gridDemoSvg = `<svg viewBox="0 0 24 24" role="img" aria-label="圖示格線示意"><defs><pattern id="b-g1" width="1" height="1" patternUnits="userSpaceOnUse"><path d="M1 0H0V1" fill="none" stroke="var(--b-line)" stroke-width=".04"/></pattern></defs><rect width="24" height="24" fill="url(#b-g1)"/><rect x="2" y="2" width="20" height="20" fill="none" stroke="var(--b-signal)" stroke-width=".08" stroke-dasharray=".4 .3"/><path d="${(icons as Record<string, string>).archive}" fill="none" stroke="var(--b-ink-1)" stroke-width="1.75" stroke-linecap="butt" stroke-linejoin="miter"/><path d="M8.5 12h7 M8.5 16h5" fill="none" stroke="var(--b-brand)" stroke-width="1.75"/></svg>`;

const dlGroups = [
  {
    title: '組合（標誌＋標準字）',
    files: [
      'taiwanmd-lockup.svg',
      'taiwanmd-lockup-dark.svg',
      'taiwanmd-lockup-zh.svg',
      'taiwanmd-lockup-zh-dark.svg',
      'taiwanmd-lockup-256.png',
      'taiwanmd-lockup-dark-256.png',
    ],
  },
  {
    title: '標誌與標準字',
    files: [
      'taiwanmd-mark.svg',
      'taiwanmd-mark-dark.svg',
      'taiwanmd-mark-mono.svg',
      'taiwanmd-wordmark.svg',
    ],
  },
  {
    title: '小尺寸與 App 圖示',
    files: [
      'taiwanmd-favicon-16.svg',
      'taiwanmd-favicon-32.svg',
      'taiwanmd-app-icon.svg',
      'taiwanmd-app-icon-512.png',
      'taiwanmd-app-icon-192.png',
      'taiwanmd-app-icon-180.png',
    ],
  },
  {
    title: '地形行與色彩',
    files: [
      'taiwanmd-ridge.svg',
      'taiwanmd-ridge-dark.svg',
      'taiwanmd-tokens.json',
    ],
  },
].map((g) => ({ ...g, files: g.files.filter((d) => downloads.includes(d)) }));
---

<Layout
  lang="zh-TW"
  title="識別手冊"
  description="Taiwan.md 識別系統 v2：台灣本島從真實高程一行一行掃描成標誌，北迴歸線那一行用文化部臺灣青。標誌、標準字、色彩、字體、77 支圖示與四層圖形的完整規範與下載。"
  readerSettings={true}
  pageType="brand"
>
  <link
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=Source+Serif+4:opsz,wght@8..60,400;8..60,600;8..60,700&display=swap"
  />
  <div class="brand-page">
    <Fragment set:html={sprite} />
    <!-- ═══ 封面 ═══ -->
    <header class="b-cover">
      <div class="b-cover-text">
        <p class="b-meta">
          識別手冊 v{I.version} · {I.date} · <span class="b-dot"></span> 手冊定稿，站體套用分兩階段
        </p>
        <div class="b-cover-lockup" set:html={lockupSvg({ zh: true })} />
        <h1 class="b-cover-title">
          台灣本島，<br />一行一行寫下來
        </h1>
        <p class="b-lede">
          標誌是把台灣本島從真實的高程資料掃描成 12
          行。每一行的兩端是海岸線，其中一行落在北迴歸線上，離玉山主峰只差四公里，整個標誌只有那一行用臺灣青。這一頁是它的完整規範：怎麼畫、怎麼用、誰可以用、哪些地方不要碰。
        </p>
      </div>
      <div
        class="b-cover-ridge"
        set:html={ridgeSvg({
          stroke: 'var(--b-cover-ink)',
          bg: 'var(--b-cover-bg)',
          sw: 3.6,
        })}
      />
    </header>

    <div class="b-body">
      <nav class="b-toc" aria-label="手冊章節">
        <ol>
          {
            chapters.map(([id, name], i) => (
              <li>
                <a href={`#${id}`}>
                  <span class="b-num">{String(i + 1).padStart(2, '0')}</span>
                  {name}
                </a>
              </li>
            ))
