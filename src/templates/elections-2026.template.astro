  | 'announcement'
  | 'law'
  | 'idRules'
  | 'pollingPlaces'
  | 'bulletin'
  | 'schedule'
  | 'referendumNotice'
  | 'referendumBulletin';

type ElectionsData = {
  lastVerified: string;
  election: {
    date: string;
    startDate: string;
    endDate: string;
    organizer: string;
    source: string;
  };
  sources: Record<string, string>;
  offices: Array<{
    key: string;
    type: string;
    seats: number | null;
    source: string;
    sourceFile?: string;
  }>;
  totalElected: { count: number; source: string };
  races: Array<{
    area: string;
    office: string;
    group: 'municipal' | 'county';
    seats: number;
    source: string;
    rosterSource: string;
    candidates: Array<{
      name: string;
      party: string;
      incumbent: boolean;
      number: number | null;
      registeredOn: string;
      source: string;
      incumbentSource?: string;
    }>;
  }>;
  votingInfo: Array<
    { id: string; links: Array<{ kind: LinkKind; url: string }> } & Record<
      UpLang,
      { q: string; a: string }
    >
  >;
  referendum: {
    case: number;
    date: string;
    hours: string;
    question: string;
    proposedBy: string;
    establishedOn: string;
    votingAge: number;
    localElectionVotingAge: number;
    threshold: string;
    presentations: { count: number; firstDate: string };
    sources: Array<{ kind: LinkKind; url: string }>;
  };
};

const electionsData = electionsDataRaw as unknown as ElectionsData;

