<script>
  // 候選人篩選：無 JS 時按鈕維持 hidden、兩組全部顯示。
  const filter = document.querySelector<HTMLElement>('[data-cand-filter]');
  if (filter) {
    filter.hidden = false;
    const groups = document.querySelectorAll<HTMLElement>('[data-cand-group]');
    const buttons = filter.querySelectorAll<HTMLButtonElement>(
      'button[data-filter]',
    );
    filter.addEventListener('click', (event) => {
      const target = event.target as HTMLElement | null;
      const btn = target?.closest<HTMLButtonElement>('button[data-filter]');
      if (!btn) return;
      const key = btn.dataset.filter;
      buttons.forEach((b) =>
        b.setAttribute('aria-pressed', b === btn ? 'true' : 'false'),
      );
      groups.forEach((g) => {
        g.hidden = key !== 'all' && g.dataset.candGroup !== key;
      });
    });
  }
</script>

