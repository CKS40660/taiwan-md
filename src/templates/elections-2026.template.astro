const lang = getLangFromUrl(Astro.url);
const copy = electionCopy[lang as keyof typeof electionCopy] ?? electionCopy.en;
const pageTitle = copy.meta.title;
const pageDescription = copy.meta.description;

const electionDate = new Date('2026-11-28T08:00:00+08:00');
const now = new Date();
const daysUntil = Math.ceil(
  (electionDate.getTime() - now.getTime()) / (1000 * 60 * 60 * 24),
);
const isUpcoming = daysUntil > 0;
const isRecent = daysUntil > -7 && daysUntil <= 0;

// Timeline milestone states — computed at build time (site rebuilds daily),
// Taipei-local date so day boundaries flip on Taiwan time.
const todayIso = new Date(now.getTime() + 8 * 60 * 60 * 1000)
  .toISOString()
  .slice(0, 10);
const nextMilestoneIdx = copy.timeline.items.findIndex(
  (m) => m.iso >= todayIso,
);
const nextMilestone =
  nextMilestoneIdx >= 0 ? copy.timeline.items[nextMilestoneIdx] : null;

// ── 2026-10 升級：衍生值 ──────────────────────────────────────────────
const upLang: UpLang = lang in upgradeCopy ? (lang as UpLang) : 'en';
const up = upgradeCopy[upLang];
const isZh = upLang === 'zh-TW';
const fill = (tpl: string, vars: Record<string, string | number>) =>
  tpl.replace(/\{(\w+)\}/g, (_, k: string) => String(vars[k] ?? ''));

// 九種職位：中選會公告有分項的用正式名額，其餘保留原數字並標「預估」。
// data.offices 與 copy.offices.items 同序（直轄市長 → 村里長）。
const officeRows = copy.offices.items.map((e, i) => {
  const seats = electionsData.offices[i]?.seats;
  return seats == null
    ? { ...e, estimate: true }
    : { ...e, count: seats, estimate: false };
});

const areaLabel = (area: string) =>
  isZh ? area : (areaI18n[area]?.[upLang as Exclude<UpLang, 'zh-TW'>] ?? area);
const partyLabel = (party: string) => {
  if (isZh) return party;
  const names = partyI18n[party];
  return names?.[upLang as Exclude<UpLang, 'zh-TW'>] ?? names?.en ?? party;
};

type Race = ElectionsData['races'][number];
// 號次全部抽出後依號次排序；抽籤前保持研究檔順序（登記日期先後）。
const isNumbered = (r: Race) => r.candidates.every((c) => c.number != null);
const orderedCandidates = (r: Race) =>
  isNumbered(r)
    ? [...r.candidates].sort((a, b) => (a.number ?? 0) - (b.number ?? 0))
    : r.candidates;
const allNumbered = electionsData.races.every(isNumbered);
const totalCandidates = electionsData.races.reduce(
  (n, r) => n + r.candidates.length,
  0,
);
const raceGroups = [
  {
    key: 'municipal' as const,
    label: up.candidates.groupMunicipal,
    races: electionsData.races.filter((r) => r.group === 'municipal'),
  },
  {
    key: 'county' as const,
    label: up.candidates.groupCounty,
    races: electionsData.races.filter((r) => r.group === 'county'),
  },
];

const faqItems = electionsData.votingInfo.map((v) => ({
  id: v.id,
  links: v.links,
  ...(v[upLang] ?? v.en),
}));
const referendum = electionsData.referendum;

// JSON-LD：Event（投票日）＋ FAQPage（怎麼投票，用當前語言）。
const pageUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url).toString();
const toJsonLd = (data: unknown) =>
  JSON.stringify(data).replace(/</g, '\\u003c');
const eventJsonLd = toJsonLd({
  '@context': 'https://schema.org',
  '@type': 'Event',
  name: up.jsonLd.eventName,
  description: up.jsonLd.eventDescription,
  startDate: electionsData.election.startDate,
  endDate: electionsData.election.endDate,
  eventStatus: 'https://schema.org/EventScheduled',
  eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
  inLanguage: upLang,
  url: pageUrl,
  location: {
    '@type': 'Place',
    name: up.jsonLd.location,
    address: { '@type': 'PostalAddress', addressCountry: 'TW' },
  },
  organizer: {
    '@type': 'GovernmentOrganization',
    name: up.jsonLd.organizer,
    url: 'https://web.cec.gov.tw/',
  },
});
const faqJsonLd = toJsonLd({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  inLanguage: upLang,
  url: pageUrl,
  mainEntity: faqItems.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
});
---

<Layout
  lang={lang}
  title={pageTitle}
  description={pageDescription}
  readerSettings
>
  <main class="elections-2026">
    <!-- Hero -->
    <section
      class="hero relative overflow-hidden border-b border-[#e7d9b8] bg-gradient-to-b from-[#fef9ed] via-[#fdf6e3] to-[#fbf3df]"
    >
      <div class="relative mx-auto max-w-[920px] px-6 py-20 md:py-28">
        <div
          class="mb-4 text-center font-mono text-xs uppercase tracking-[0.18em] text-[#92400e]"
        >
          {copy.hero.eyebrow}
        </div>

        <h1
          class="hero-title mb-6 text-center text-[2.5rem] font-bold leading-[1.15] text-[#1f2937] md:text-[3.5rem]"
          style="font-family: 'jf-lanyangming', 'rixingsong-semibold', 'Noto Serif TC', 'Source Han Serif TC', serif;"
        >
          {copy.hero.titlePrefix}
          <span class="text-[#7c2d12]">{copy.hero.titleEmphasis}</span>
          {copy.hero.titleSuffix}
        </h1>

        <p class="mb-10 text-center text-lg italic text-[#52525b] md:text-xl">
          {copy.hero.subtitle}
        </p>

        {
          isUpcoming && (
            <div class="mx-auto flex max-w-[420px] flex-col items-center gap-3 rounded-2xl border-[1.5px] border-[#7c2d12]/20 bg-white/70 px-10 py-8 shadow-[0_4px_20px_rgba(124,45,18,0.08)] backdrop-blur-sm">
              <div class="text-xs uppercase tracking-[0.2em] text-[#92400e]">
                {copy.hero.countdownLabel}
              </div>
              <div class="flex items-baseline gap-2">
                <span class="text-7xl font-bold text-[#7c2d12] md:text-8xl">
                  {daysUntil}
                </span>
                <span class="text-2xl text-[#92400e]">{copy.hero.dayUnit}</span>
              </div>
              <div class="text-sm text-[#78716c]">{copy.hero.dateLabel}</div>
            </div>
          )
        }

        {
          isRecent && (
            <div class="mx-auto max-w-[420px] rounded-2xl border-[1.5px] border-[#7c2d12]/30 bg-white/80 px-10 py-8 text-center shadow-[0_4px_20px_rgba(124,45,18,0.08)]">
              <div class="text-2xl font-bold text-[#7c2d12]">
                {copy.hero.recentTitle}
              </div>
              <div class="mt-2 text-base text-[#78716c]">
                {copy.hero.recentSubtitle}
              </div>
            </div>
          )
        }

        <!-- 快速導覽：三個錨點＋下一站 -->
        <nav
          aria-label={up.nav.label}
          class="mx-auto mt-10 flex max-w-[640px] flex-col items-center gap-4"
        >
          <div class="flex flex-wrap justify-center gap-2.5">
            {
              [
                { href: '#candidates', label: up.nav.candidates },
                { href: '#how-to-vote', label: up.nav.howToVote },
                { href: '#timeline', label: up.nav.timeline },
              ].map((l) => (
                <a
                  href={l.href}
                  class="inline-flex items-center gap-1.5 rounded-full border-[1.5px] border-[#7c2d12]/25 bg-white/80 px-5 py-2 text-sm font-semibold text-[#7c2d12] no-underline transition-all duration-[200ms] hover:-translate-y-px hover:border-[#7c2d12]/50 hover:bg-[#fef2ec]"
                >
                  {l.label}
                  <span aria-hidden="true">↓</span>
                </a>
              ))
            }
          </div>
          {
            nextMilestone && (
              <p class="flex flex-wrap items-baseline justify-center gap-x-2 gap-y-1 text-center text-sm text-[#52525b]">
                <span class="rounded-full bg-[#fef3c7] px-2 py-0.5 font-mono text-[10px] uppercase tracking-wider text-[#92400e]">
                  {copy.timeline.nextLabel}
                </span>
                <span class="font-mono tabular-nums text-[#7c2d12]">
                  {nextMilestone.date}
                </span>
                <span>{nextMilestone.label}</span>
              </p>
            )
          }
        </nav>
      </div>
    </section>

    <!-- Role -->
    <section class="bg-[#fdfaf2] py-16 md:py-20">
      <div class="mx-auto max-w-[760px] px-6">
        <h2
          class="mb-8 text-center text-[1.75rem] font-light text-[#1f2937] md:text-[2.25rem]"
          style="font-family: 'jf-lanyangming', 'Noto Serif TC', serif;"
        >
          {copy.role.title}
        </h2>

        <div
          class="rounded-2xl border-[1.5px] border-[#e7d9b8] bg-white/60 p-8 md:p-12"
        >
          <p class="mb-5 text-lg leading-[1.85] text-[#374151]">
            {copy.role.p1}
          </p>
          <p class="mb-5 text-base leading-[1.85] text-[#52525b]">
            {copy.role.p2}
          </p>
          <p class="mb-5 text-base leading-[1.85] text-[#52525b]">
            {copy.role.p3}
          </p>
          <p class="text-base leading-[1.85] text-[#52525b]">{copy.role.p4}</p>

          <div class="mt-8 flex flex-wrap gap-3">
            <a
              href={copy.related.articles[0].href}
              class="inline-flex items-center gap-2 rounded-lg border-[1.5px] border-[#7c2d12]/25 bg-[#fef2ec] px-5 py-2.5 text-sm font-semibold text-[#7c2d12] no-underline transition-all duration-[200ms] hover:-translate-y-px hover:border-[#7c2d12]/50 hover:bg-[#fce7d6] hover:shadow-[0_2px_8px_rgba(124,45,18,0.12)]"
            >
              {copy.role.primaryCta}
            </a>
            <a
              href={copy.related.articles[2].href}
              class="inline-flex items-center gap-2 rounded-lg border-[1.5px] border-[#d1d5db] bg-[#f8fafc] px-5 py-2.5 text-sm font-semibold text-[#374151] no-underline transition-all duration-[200ms] hover:-translate-y-px hover:border-[#9ca3af] hover:bg-[#f1f5f9]"
            >
              {copy.role.secondaryCta}
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Offices -->
    <section class="bg-white py-16 md:py-24">
      <div class="mx-auto max-w-[1080px] px-6">
        <div class="mb-12 text-center">
          <h2
            class="mb-4 text-[1.75rem] font-light text-[#1f2937] md:text-[2.25rem]"
            style="font-family: 'jf-lanyangming', 'Noto Serif TC', serif;"
          >
            {copy.offices.title}
          </h2>
          <p
            class="mx-auto max-w-[640px] text-base leading-[1.75] text-[#52525b]"
          >
            {copy.offices.intro}
          </p>
        </div>

        <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {
            officeRows.map((e) => (
              <div class="group rounded-xl border-[1.5px] border-[#e5e7eb] bg-white p-6 transition-all duration-[200ms] hover:-translate-y-1 hover:border-[#d1d5db] hover:shadow-[0_8px_24px_rgba(0,0,0,0.06)]">
                <div class="mb-3 flex items-baseline justify-between gap-3">
                  <h3
                    class="text-lg font-semibold text-[#1f2937]"
                    style="font-family: 'Noto Serif TC', serif;"
                  >
                    {e.name}
                  </h3>
                  <span
                    class="shrink-0 text-3xl font-bold tabular-nums"
                    style={`color: ${e.accent}`}
                  >
                    {e.estimate && (
                      <span class="text-base font-semibold">
                        {up.offices.approxPrefix}
                      </span>
                    )}
                    {e.count.toLocaleString()}
                  </span>
                </div>
                <p class="text-sm leading-[1.65] text-[#6b7280]">
                  {e.desc}
                  {e.estimate && (
                    <span class="ml-1.5 inline-block rounded border border-[#d1d5db] px-1.5 align-middle font-mono text-[10px] text-[#6b7280]">
                      {up.offices.estimateLabel}
                    </span>
                  )}
                </p>
              </div>
            ))
          }
        </div>

        <p class="mt-8 text-center text-xs italic text-[#9ca3af]">
          {copy.offices.sourceNote}
        </p>
      </div>
    </section>

    <!-- 縣市長候選人（中選會 2026-10-16 審定名單；對稱呈現、無政黨色） -->
    <section id="candidates" class="anchor-section bg-[#fdfaf2] py-16 md:py-24">
      <div class="mx-auto max-w-[1080px] px-6">
        <div class="mb-8 text-center">
          <h2
            class="mb-4 text-[1.75rem] font-light text-[#1f2937] md:text-[2.25rem]"
            style="font-family: 'jf-lanyangming', 'Noto Serif TC', serif;"
          >
            {up.candidates.title}
          </h2>
          <p
            class="mx-auto max-w-[640px] text-base leading-[1.75] text-[#52525b]"
          >
            {
              fill(up.candidates.intro, {
                races: electionsData.races.length,
                count: totalCandidates,
              })
            }
          </p>
          <p
            class="mx-auto mt-3 max-w-[640px] text-sm leading-[1.7] text-[#78716c]"
          >
            {allNumbered ? up.candidates.noteNumbered : up.candidates.note}
            <span class="whitespace-nowrap">
              {' '}
              {up.candidates.dataDate}
              <time datetime={electionsData.lastVerified} class="font-mono"
                >{electionsData.lastVerified}</time
              >
            </span>
          </p>
        </div>

        <div
          class="cand-filter mb-8 justify-center"
          role="group"
          aria-label={up.candidates.filterLabel}
          data-cand-filter
          hidden
        >
          {
            [
              { key: 'all', label: up.candidates.filterAll },
              { key: 'municipal', label: up.candidates.filterMunicipal },
              { key: 'county', label: up.candidates.filterCounty },
            ].map((f, i) => (
              <button
                type="button"
                data-filter={f.key}
                aria-pressed={i === 0 ? 'true' : 'false'}
                class="cand-filter-btn rounded-full border-[1.5px] border-[#d1d5db] bg-white px-4 py-1.5 text-sm font-semibold text-[#374151] transition-colors duration-[200ms] hover:border-[#9ca3af]"
              >
                {f.label}
              </button>
            ))
          }
        </div>

        {
          raceGroups.map((g) => (
            <div class="cand-group mb-12 last:mb-0" data-cand-group={g.key}>
              <h3
                class="mb-5 flex items-baseline gap-3 border-b border-[#e7d9b8] pb-2 text-xl font-semibold text-[#1f2937]"
                style="font-family: 'Noto Serif TC', serif;"
              >
                {g.label}
                <span class="text-sm font-normal text-[#78716c]">
                  {fill(up.candidates.groupCount, { n: g.races.length })}
                </span>
              </h3>
              <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
                {g.races.map((race) => {
                  const hasIncumbent = race.candidates.some((c) => c.incumbent);
                  const incumbentSource = race.candidates.find(
                    (c) => c.incumbentSource,
                  )?.incumbentSource;
                  return (
                    <article class="flex flex-col rounded-xl border-[1.5px] border-[#e5e7eb] bg-white p-5">
                      <header class="mb-3 flex items-baseline justify-between gap-3">
                        <h4
                          class="text-lg font-semibold text-[#1f2937]"
                          style="font-family: 'Noto Serif TC', serif;"
                        >
                          {areaLabel(race.area)}
                          {!isZh && (
                            <span
                              class="ml-2 text-sm font-normal text-[#9ca3af]"
                              lang="zh-Hant"
                            >
                              {race.area}
                            </span>
                          )}
                        </h4>
                        <span class="shrink-0 text-xs text-[#78716c]">
                          {fill(up.candidates.candidateCount, {
                            n: race.candidates.length,
                          })}
                        </span>
                      </header>
                      <ul class="m-0 list-none divide-y divide-[#f1f0ec] p-0">
                        {orderedCandidates(race).map((c) => (
                          <li class="flex flex-wrap items-baseline gap-x-2 gap-y-0.5 py-2">
                            {c.number != null && (
                              <span class="font-mono text-xs tabular-nums text-[#6b7280]">
                                {fill(up.candidates.numberLabel, {
                                  n: c.number,
                                })}
                              </span>
                            )}
                            <span
                              class="cand-name text-base font-semibold text-[#1f2937]"
                              lang={isZh ? undefined : 'zh-Hant'}
                            >
                              {c.name}
                            </span>
                            <span
                              class="text-sm text-[#6b7280]"
                              lang={
                                isZh || partyLabel(c.party) !== c.party
                                  ? undefined
                                  : 'zh-Hant'
                              }
                            >
                              {partyLabel(c.party)}
                            </span>
                            {c.incumbent && (
                              <span class="rounded border border-[#d1d5db] px-1.5 text-[11px] leading-[1.5] text-[#6b7280]">
                                {up.candidates.incumbent}
                              </span>
                            )}
                          </li>
                        ))}
                      </ul>
                      <footer class="mt-auto pt-3 text-[11px] leading-[1.6] text-[#9ca3af]">
                        <p>
                          {up.candidates.sourceLabel}
                          <a
                            href={race.rosterSource}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="text-[#6b7280] underline decoration-[#d1d5db] underline-offset-2 hover:text-[#374151]"
                          >
                            {up.candidates.rosterLink}
                          </a>
                          {up.candidates.listSep}
                          <a
                            href={race.source}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="text-[#6b7280] underline decoration-[#d1d5db] underline-offset-2 hover:text-[#374151]"
                          >
                            {up.candidates.qualifiedLink}
                          </a>
                        </p>
                        {hasIncumbent && incumbentSource && (
                          <p>
                            <a
                              href={incumbentSource}
                              target="_blank"
                              rel="noopener noreferrer"
                              class="text-[#6b7280] underline decoration-[#d1d5db] underline-offset-2 hover:text-[#374151]"
                            >
                              {up.candidates.incumbentNote}
                            </a>
                          </p>
                        )}
                      </footer>
                    </article>
                  );
                })}
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <!-- 怎麼投票（問答；預設展開前三條）＋同日公投 -->
    <section id="how-to-vote" class="anchor-section bg-white py-16 md:py-24">
      <div class="mx-auto max-w-[760px] px-6">
        <div class="mb-10 text-center">
          <h2
            class="mb-4 text-[1.75rem] font-light text-[#1f2937] md:text-[2.25rem]"
            style="font-family: 'jf-lanyangming', 'Noto Serif TC', serif;"
          >
            {up.howToVote.title}
          </h2>
          <p
            class="mx-auto max-w-[640px] text-base leading-[1.75] text-[#52525b]"
          >
            {up.howToVote.intro}
          </p>
        </div>

        <div class="space-y-3">
          {
            faqItems.map((f, i) => (
              <details
                id={`vote-${f.id}`}
                class="faq-item group rounded-xl border-[1.5px] border-[#e5e7eb] bg-white open:border-[#e7d9b8] open:bg-[#fffdf7]"
                open={i < 3}
              >
                <summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-5 py-4">
                  <h3 class="text-base font-semibold text-[#1f2937] md:text-lg">
                    {f.q}
                  </h3>
                  <span
                    aria-hidden="true"
                    class="faq-chevron shrink-0 text-[#92400e] transition-transform duration-[200ms]"
                  >
                    ▾
                  </span>
                </summary>
                <div class="px-5 pb-5">
                  <p class="text-[0.95rem] leading-[1.85] text-[#374151]">
                    {f.a}
                  </p>
                  <p class="mt-3 text-xs leading-[1.7] text-[#78716c]">
                    {up.howToVote.sourceLabel}
                    {f.links.map((l, j) => (
                      <>
                        {j > 0 && up.candidates.listSep}
                        <a
                          href={l.url}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="text-[#7c2d12] underline decoration-[#7c2d12]/30 underline-offset-2 hover:decoration-[#7c2d12]"
                        >
                          {up.links[l.kind]}
                        </a>
                      </>
                    ))}
                  </p>
                </div>
              </details>
            ))
          }
        </div>

        <!-- 同日公投：完全中立，只列程序事實 -->
        <article
          id="referendum"
          class="anchor-section mt-12 rounded-2xl border-[1.5px] border-[#d1d5db] bg-[#f8fafc] p-6 md:p-8"
        >
          <div
            class="mb-2 font-mono text-xs uppercase tracking-[0.18em] text-[#6b7280]"
          >
            {up.referendum.eyebrow}
          </div>
          <h3
            class="mb-3 text-xl font-semibold text-[#1f2937] md:text-2xl"
            style="font-family: 'Noto Serif TC', serif;"
          >
            {up.referendum.title}
          </h3>
          <p class="mb-6 text-[0.95rem] leading-[1.8] text-[#374151]">
            {up.referendum.lead}
          </p>

          <div class="mb-6 rounded-xl border border-[#e5e7eb] bg-white p-5">
            <div class="mb-2 text-xs text-[#6b7280]">
              {up.referendum.questionLabel}
            </div>
            <p
              class="text-lg font-semibold leading-[1.7] text-[#1f2937]"
              lang="zh-Hant"
              style="font-family: 'Noto Serif TC', serif;"
            >
              「{referendum.question}」
            </p>
            {
              up.referendum.translation && (
                <div class="mt-4 border-t border-[#f1f0ec] pt-3">
                  <div class="mb-1 text-xs text-[#6b7280]">
                    {up.referendum.translationLabel}
                  </div>
                  <p class="text-[0.95rem] leading-[1.7] text-[#374151]">
                    {up.referendum.translation}
                  </p>
                </div>
              )
            }
          </div>

          <dl class="grid gap-4 sm:grid-cols-2">
            {
              up.referendum.facts.map((fact) => (
                <div>
                  <dt class="mb-1 text-xs font-semibold uppercase tracking-wider text-[#6b7280]">
                    {fact.label}
                  </dt>
                  <dd class="text-sm leading-[1.75] text-[#374151]">
                    {fact.text}
                  </dd>
                </div>
              ))
            }
          </dl>

          <p
            class="mt-6 border-t border-[#e5e7eb] pt-4 text-xs leading-[1.7] text-[#6b7280]"
          >
            {up.referendum.neutral}
          </p>
          <p class="mt-2 text-xs leading-[1.7] text-[#6b7280]">
            {up.referendum.sourceLabel}
            {
              referendum.sources.map((s, j) => (
                <>
                  {j > 0 && up.candidates.listSep}
                  <a
                    href={s.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-[#374151] underline decoration-[#9ca3af] underline-offset-2 hover:text-[#1f2937]"
                  >
                    {up.links[s.kind]}
                  </a>
                </>
              ))
            }
          </p>
        </article>
      </div>
    </section>

    <!-- 選務時程（中選會第 622 次委員會議決議） -->
